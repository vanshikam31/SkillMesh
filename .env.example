# Copy this file to .env and edit. With no DATABASE_URL the app uses a local SQLite file (easy for development).
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillmesh
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
