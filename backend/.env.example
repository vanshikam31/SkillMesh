# Copy this file to .env and edit. With no DATABASE_URL the app uses a local SQLite file (easy for development).
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillmesh
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Password reset email ---
# Where your frontend runs (used to build the reset link). On deployment use your Vercel URL.
FRONTEND_URL=http://localhost:5173
# To send REAL emails, remove the # from the 4 lines below and fill them in (Gmail example).
# Gmail needs an App Password: turn on 2-Step Verification, then https://myaccount.google.com/apppasswords
# Test your settings with:  python backend/test_email.py your-email@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# While SMTP is empty, the reset link is shown on the screen instead (development only). On deployment set this to false:
SHOW_RESET_LINK=true

# --- Sample students ---
# on   = real users + the 48 sample students (good for demos)
# off  = real users only (use this when real users have joined)
# auto = samples only while there are fewer than SAMPLE_AUTO_THRESHOLD real users
SAMPLE_USERS=on
SAMPLE_AUTO_THRESHOLD=10

# Demo helper: sample students accept requests and reply to chat by themselves. Set to false when real users have joined.
SAMPLE_AUTO_REPLY=true
