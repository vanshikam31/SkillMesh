# Copy this file to .env and edit. With no DATABASE_URL the app uses a local SQLite file (easy for development).
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillmesh
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Password reset ---
# Where your frontend runs (used to build the reset link). On deployment use your Vercel URL.
FRONTEND_URL=http://localhost:5173
# Leave SMTP empty while developing: the reset link is shown on the screen and printed in the backend terminal.
# For real emails (example: Gmail with an App Password, https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# On deployment set this to false once SMTP is configured:
SHOW_RESET_LINK=true
